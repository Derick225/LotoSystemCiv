{
  "entities": {
    "draw_results": {
      "title": "Draw Results",
      "description": "Historical lottery draw results",
      "type": "object",
      "properties": {
        "draw_name": { "type": "string" },
        "date": { "type": "string" },
        "gagnants": { "type": "array", "items": { "type": "number" } },
        "machine": { "type": "array", "items": { "type": "number" } },
        "created_at": { "type": "string" }
      },
      "required": ["draw_name", "date"]
    },
    "predictions": {
      "title": "Predictions",
      "description": "Generated lottery predictions",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "draw_name": { "type": "string" },
        "date": { "type": "string" },
        "predictions": { "type": "array" },
        "confidence": { "type": "number" },
        "created_at": { "type": "string" }
      },
      "required": ["draw_name"]
    },
    "prediction_snapshots": {
      "title": "Prediction Snapshots",
      "description": "Snapshots of prediction history",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "draw_name": { "type": "string" },
        "snapshot_data": { "type": "object" },
        "created_at": { "type": "string" }
      }
    },
    "algo_weights": {
      "title": "Algo Weights",
      "description": "Weights for prediction algorithms",
      "type": "object",
      "properties": {
        "draw_name": { "type": "string" },
        "weights": { "type": "object" },
        "updated_at": { "type": "string" }
      }
    },
    "learning_logs": {
      "title": "Learning Logs",
      "description": "Logs of ML learning sessions",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "log": { "type": "object" },
        "created_at": { "type": "string" }
      }
    },
    "learning_sessions": {
      "title": "Learning Sessions",
      "description": "ML Learning sessions",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "session_data": { "type": "object" },
        "created_at": { "type": "string" }
      }
    },
    "forensic_reports": {
      "title": "Forensic Reports",
      "description": "Deep analysis forensic reports",
      "type": "object",
      "properties": {
        "user_id": { "type": "string" },
        "report": { "type": "object" },
        "created_at": { "type": "string" }
      }
    }
